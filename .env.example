# GEMINI_API_KEY: Required for optional server-side Strategic Thinking Partner API calls.
# AI Studio injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (used for canonical URLs, sitemap, and checkout redirects).
APP_URL="MY_APP_URL"

# SESSION_SECRET: Random 32+ char secret for HMAC-signed HTTP-only session cookies.
# Auto-generated securely per runtime if omitted, though setting a persistent value preserves sessions across restarts.
SESSION_SECRET=""

# ADMIN_EMAILS: Comma-separated email addresses permitted administrator access after server-side authentication.
ADMIN_EMAILS=""

# ADMIN_BOOTSTRAP_PASSWORD: Optional initial password to seed an administrator account for ADMIN_EMAILS on first boot.
ADMIN_BOOTSTRAP_PASSWORD=""

# STRIPE_SECRET_KEY & STRIPE_WEBHOOK_SECRET: Optional Stripe configuration for verified guided program checkouts.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# INQUIRY_WEBHOOK_URL: Optional webhook destination (Slack, CRM, or email relay) for For Teams inquiries.
INQUIRY_WEBHOOK_URL=""
